# TM_CLIENT_SECRET=ybSCy2L9W2memiTidp3XCawKIZkeRX8OcdjN1Uun

# OSM OAUTH2
TM_CLIENT_ID=8rtzjOMHNke9-FSmv_9BDusWvuhEOB6SNAQnq2JEG34
TM_CLIENT_SECRET=pnHE1IJwHvF_Dp-JgQyGxDqaI9w3bi4ivAwMTAsFt10

# Redirect uri registered while creating OAuth2 application (required)
TM_REDIRECT_URI=https://osmit-tm4.wmcloud.org/authorized

# Scope of TM defined while creating OAuth2 application (required)
TM_SCOPE=read_prefs write_api

TM_IMPORT_MAX_FILESIZE=1000000
TM_MAX_AOI_AREA=5000
